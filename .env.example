# Required: folder containing images/ and train_labels.csv
DATASET_PATH=./data/

# Required: where checkpoints are written (one subfolder per run). Keep it git-ignored.
MODEL_DIR=./runs/

# Required only for the agent (main.py): key for the LLM endpoint
API_KEY=

# Optional: OpenAI-compatible LLM endpoint. Leave empty for the OpenAI default.
BASE_URL=

# Optional: LLM model name. Defaults to gpt-4.1-mini.
LLM_MODEL=gpt-4.1-mini
